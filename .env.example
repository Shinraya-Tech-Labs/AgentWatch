# AgentWatch Environment Configuration Template
# Copy this file to .env and configure the variables for your environment.
# Do not commit the actual .env file containing sensitive values to version control.

# ==============================================================================
# Database Configuration
# ==============================================================================

# Full asyncpg connection string (takes precedence over individual DB_* vars).
DATABASE_URL=postgresql+asyncpg://postgres:your_password_here@localhost:5432/panoptis

# Individual database connection parameters (used when DATABASE_URL is not set).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=panoptis
DB_USER=postgres

# PostgreSQL user password (required if using individual parameters).
DB_PASSWORD=your_password_here

# Alternative environment variable name for the PostgreSQL password (optional).
PGPASSWORD=your_password_here


# ==============================================================================
# Rate limiting
# ==============================================================================

# Proxies allowed to name the client in X-Forwarded-For, comma separated. Leave empty when
# clients connect directly: the header is then ignored, because anyone can write it. Behind a
# proxy that is not listed here, every client shares that proxy's rate-limit quota.
AGENTWATCH_TRUSTED_PROXIES=

# ==============================================================================
# Redis & Celery Configuration
# ==============================================================================

# Connection string for Redis.
REDIS_URL=redis://localhost:6379/0

# docker compose requires both (no defaults; at least 12 characters). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(18))"
# Postgres and Redis are published on 127.0.0.1 only; Redis requires this password.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# The API and dashboard bind to 127.0.0.1 unless you set this (e.g. 0.0.0.0 behind TLS).
# AGENTWATCH_BIND_HOST=127.0.0.1

# Celery broker connection string (falls back to REDIS_URL if not set).
CELERY_BROKER_URL=redis://localhost:6379/1

# Celery result backend connection string (falls back to REDIS_URL if not set).
CELERY_RESULT_BACKEND=redis://localhost:6379/1


# ==============================================================================
# API Configuration
# ==============================================================================

# Secret API key required in the 'X-Api-Key' header.
# MANDATORY in production (AGENTWATCH_ENV=production) and for `docker compose up`, which runs
# the API in production mode and refuses to start without it. Unauthenticated if empty in
# development. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# CLI commands that call the API (status, sessions, export, compare, session
# prune) read this as a fallback for --api-key and send it in the X-Api-Key header.
AGENTWATCH_API_KEY=

# Self-hosted multi-tenant: a server-side map of tenant=key pairs (comma or newline
# separated). A request's tenant is the tenant of its key; X-Tenant-ID may only repeat it.
# AGENTWATCH_TENANT_KEYS=acme=<random key>,globex=<random key>

# Cloud mode: operator credential for cross-tenant and global routes (tenant admin,
# dashboards, audit/compliance reports, safety policy). Unset = those routes are refused.
# AGENTWATCH_ADMIN_KEY=

# Where tenants, API-key hashes, revocations and usage are stored (SQLAlchemy URL).
# Cloud mode always uses a database: this, else AGENTWATCH_STORE, else
# $AGENTWATCH_HOME/tenants.db. Point every API replica at the same database.
# AGENTWATCH_TENANT_STORE=postgresql+psycopg://user:pass@db:5432/agentwatch

# URL of the AgentWatch API server for CLI/adapters to forward reasoning traces.
AGENTWATCH_API_URL=http://localhost:8000

# Comma-separated allowed CORS origins for the API server. If empty, any origin may call
# the API but browsers send no credentials (the API key is a header, so it is still needed).
CORS_ALLOWED_ORIGINS=http://localhost:3000


# ==============================================================================
# LLM Providers & Auditing (Reasoning Auditor)
# ==============================================================================

# Anthropic API Key used by the Reasoning Auditor to score agent steps and detect drift.
ANTHROPIC_API_KEY=your_anthropic_key_here

# Secret key used for signing/benchmarking reasoning auditor tasks.
AGENTWATCH_BENCH_KEY=default


# ==============================================================================
# Environment Setting
# ==============================================================================

# General application environment mode (e.g., development, production, test).
ENVIRONMENT=development

# AgentWatch specific environment mode (defaults to production if not set).
AGENTWATCH_ENV=development


# ==============================================================================
# Alerting integrations (Optional)
# ==============================================================================

# Slack incoming webhook URL for posting alerts when high-risk commands are blocked.
SLACK_WEBHOOK_URL=

# PagerDuty integration webhook URL for paging when high-risk events occur.
PAGERDUTY_WEBHOOK_URL=

# PagerDuty webhook URL for alert delivery.
PAGERDUTY_WEBHOOK_URL=


# ==============================================================================
# Frontend Configuration (Next.js Dashboard)
# ==============================================================================

# Full API base URL (defaults to '/api/v1'). Example: http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=

# ==============================================================================
# AgentWatch v3 (see docs/v3/USER_GUIDE.md)
# ==============================================================================

# v3 evidence store: sqlite:///path or postgresql+psycopg://user:pass@host:5432/db.
# Default: $AGENTWATCH_HOME/agentwatch.db (docker-compose sets the Postgres service).
# AGENTWATCH_STORE=
# Directory for local v3 data (default ~/.agentwatch).
# AGENTWATCH_HOME=
# Directory for content-addressed blobs (large payloads). Default: under AGENTWATCH_HOME.
# AGENTWATCH_BLOB_DIR=
# 1 = encrypt payloads per data subject, enabling crypto-shredding erasure (ADR-0011).
AGENTWATCH_ENCRYPT_PAYLOADS=0
# 1 = let the API re-run recorded commands (L2/L3 replay, branches). Any client that can
# ingest observations can then choose a command the server runs: trusted single-user only.
AGENTWATCH_ALLOW_REEXECUTION=0
# JSON file of declared entity aliases, e.g. {"model:gpt-4o": "model:openai/gpt-4o"}.
# AGENTWATCH_ENTITY_ALIASES=

# ─── Persistence failure behaviour (docs/PERSISTENCE.md) ──────────────────────
# With DATABASE_URL set, an unreachable database stops the API at startup. Outside
# production only, 1 lets it start in memory, reported as degraded (/health 503) and
# with every write answered 503 "not persisted". Never set this in production.
# AGENTWATCH_ALLOW_MEMORY_FALLBACK=0

# ─── Request limits (docs/PERSISTENCE.md) ─────────────────────────────────────
# AGENTWATCH_MAX_BODY_BYTES=10485760
# AGENTWATCH_MAX_BATCH_ITEMS=5000
# AGENTWATCH_MAX_JSON_DEPTH=64
# AGENTWATCH_MAX_STRING_BYTES=4194304
# AGENTWATCH_WS_MAX_BYTES=1048576

# ─── Attestation seals (docs/ATTESTATION_KEYS.md) ─────────────────────────────
# kid=<base64 key>, comma separated. No default key exists; generate with:
#   python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# AGENTWATCH_ATTEST_KEYS=
# AGENTWATCH_ATTEST_ACTIVE_KID=
# AGENTWATCH_ATTEST_REVOKED=
# AGENTWATCH_REQUIRE_ATTESTATION=0
